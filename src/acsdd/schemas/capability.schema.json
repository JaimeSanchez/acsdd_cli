{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACSDD Capability Manifest",
  "type": "object",
  "required": ["capability"],
  "properties": {
    "capability": {
      "type": "object",
      "required": ["id", "version", "name", "category", "description", "inputs", "outputs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,4}-[0-9]{3}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "enum": ["PLAN", "PROFILE", "DB", "BE", "FE", "TEST", "DOC", "DEVOPS", "SEC", "REF"]
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["spec-ref", "file-path", "string", "number", "boolean", "json", "markdown"]
              },
              "required": { "type": "boolean", "default": true },
              "default": {},
              "description": { "type": "string" }
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["file-path", "string", "json", "markdown", "boolean"]
              },
              "pattern": { "type": "string" }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": ["capability"],
            "properties": {
              "capability": {
                "type": "string",
                "pattern": "^[A-Z]{2,4}-[0-9]{3}$"
              },
              "version": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stack", "adapter-id"],
            "properties": {
              "stack": { "type": "string" },
              "adapter-id": { "type": "string" }
            }
          }
        },
        "profile_constraints": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        },
        "quality_gates": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        },
        "token_budget": {
          "type": "object",
          "properties": {
            "planning": { "type": "integer", "minimum": 500 },
            "implementation": { "type": "integer", "minimum": 500 },
            "validation": { "type": "integer", "minimum": 500 }
          },
          "default": { "planning": 4000, "implementation": 8000, "validation": 2000 }
        },
        "security_constraints": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        }
      }
    }
  }
}
